# Publish only the static website. Everything else stays local.
/*
!/.gitignore
!/LICENSE
!/NOTICE.txt
!/_headers
!/index.html
!/favicon.svg
!/css/
/css/*
!/css/*.css
!/js/
/js/*
!/js/*.js
!/vendor/
/vendor/*
!/vendor/*.min.js
!/vendor/*.LICENSE.txt
!/data/
/data/*
!/data/city-evidence.js
!/data/city-accessibility.js
!/data/city-costs.js
!/data/train-accessibility.js
!/data/countries.geojson
!/data/countries.geojson.js
!/data/rail-network.json
!/data/rail-network.json.js
!/data/coverage.js
